# Copy file này thành .env.local và điền giá trị thật (không commit .env.local)

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) hoặc legacy anon key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) hoặc legacy service_role key — CHỈ đặt ở server.
# Cần cho trang quản trị (quản lý user + danh mục). Tuyệt đối không đưa vào apps/.
SUPABASE_SECRET_KEY=

# Origin của FE được phép gọi API kèm cookie (mặc định http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# --- Google Drive / Sheets ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PARENT_FOLDER_ID=
